# Monitoring (Spring Boot Admin) environment — copy to /etc/kundli/admin.env
# (chmod 640, root:kundli). Holds the dashboard login and SMTP credentials.

# --- Dashboard login (reach the UI over an SSH tunnel; see infra/DEPLOY.md) ---
KUNDLI_ADMIN_USER=admin
KUNDLI_ADMIN_PASSWORD=change-me-to-something-strong
# KUNDLI_ADMIN_PORT=9090

# --- Email alerts (SMTP). Leave KUNDLI_SMTP_HOST empty to run the dashboard without email. ---
# Example for Amazon SES SMTP (ap-south-1); Gmail: smtp.gmail.com:587 + an app password.
KUNDLI_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
KUNDLI_SMTP_PORT=587
KUNDLI_SMTP_USER=YOUR_SMTP_USERNAME
KUNDLI_SMTP_PASSWORD=YOUR_SMTP_PASSWORD

# Where alerts go, and the From address (must be a verified sender for SES).
KUNDLI_ALERT_TO=you@example.com
KUNDLI_ALERT_FROM=kundli-monitor@ashutoshkumar.codes
