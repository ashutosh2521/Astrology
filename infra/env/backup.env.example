# Backup environment — copy to /etc/kundli/backup.env (chmod 640, root:kundli).
# KUNDLI_DB_PATH is already provided by backend.env; only the destination is set here.

# S3 destination for nightly SQLite snapshots.
KUNDLI_S3_BUCKET=s3://your-bucket/kundli

# Prefer an EC2 instance IAM role for credentials. If you must use static keys instead,
# set them here (and keep this file 640 root:kundli):
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=ap-south-1
