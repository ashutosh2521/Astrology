# Backend environment — copy to /etc/kundli/backend.env (chmod 640, root:kundli).
# Spring Boot relaxed binding maps these UPPER_SNAKE names onto the properties in
# backend/src/main/resources/application.properties.

# SQLite database file. Lives under the systemd StateDirectory (/var/lib/kundli).
KUNDLI_DB_PATH=/var/lib/kundli/kundli.db

# HTTP port Spring Boot listens on (localhost; Nginx reverse-proxies to it). Maps to server.port.
SERVER_PORT=8080

# Ephemeris service location. Maps to kundli.ephemeris.base-url. Keep it on loopback.
KUNDLI_EPHEMERIS_BASEURL=http://127.0.0.1:8001

# --- Optional overrides (defaults in application.properties are fine for personal scale) ---
# Identify yourself to OpenStreetMap Nominatim per its usage policy if you change the default.
# KUNDLI_GEOCODING_USERAGENT=AstrologyKundliApp/1.0 (github.com/ashutosh2521/astrology)
# Set to false to disable online birthplace lookup entirely (bundled city list only).
# KUNDLI_GEOCODING_ENABLED=true
