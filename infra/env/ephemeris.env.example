# Ephemeris service environment — copy to /etc/kundli/ephemeris.env (chmod 640, root:kundli).
#
# Host/port are NOT set here on purpose: the systemd unit hardcodes the loopback bind so
# it can never be widened by an env edit. This file only points the service at its data.

# Directory holding the Swiss Ephemeris .se1 data files (read-only to the service).
EPHE_PATH=/opt/kundli/ephe
