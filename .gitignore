# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Swiss Ephemeris data files (downloaded at deploy time, not committed — large binaries)
ephemeris-service/ephe/*.se1

# Java / Spring Boot
target/
*.class
.gradle/
build/

# Node / Angular / Ionic
node_modules/
dist/
.angular/

# SQLite
*.db
*.sqlite
*.sqlite3

# Env / secrets
.env
*.local

# Android / Capacitor
# The android/ folder is regenerated by `npx cap add android`; commit gradle
# wrapper + AndroidManifest customisations to source control if you fork this
# project, but never the build cache or the signing keystore.
web/android/.gradle/
web/android/app/build/
web/android/build/
web/android/local.properties
web/android/*.iml
web/android/.idea/
web/android/app/release/
*.keystore
*.jks
web/capacitor.build.gradle
web/android/capacitor-cordova-android-plugins/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*.log
